---
interface Props {
  title: string;
  blurb: string;
}

const { title, blurb } = Astro.props;
---

<section class="max-w-2xl mx-auto px-6 pt-20 pb-24 text-center">
  <span class="font-sans text-xs font-medium tracking-widest uppercase text-forest">Coming Soon</span>
  <h1 class="font-serif text-4xl md:text-5xl font-semibold text-ink mt-3 mb-4">{title}</h1>
  <p class="font-sans text-ink-light text-lg leading-relaxed">{blurb}</p>
</section>
