---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RetreatSubNav from '../../../components/RetreatSubNav.astro';
import Gallery from '../../../components/Gallery.astro';

const images = [
  { src: '/images/gallery/39.jpg', alt: 'Fields near Longthwaite' },
  { src: '/images/gallery/40.jpg', alt: 'Rosalyn and Milly out on a walk' },
  { src: '/images/gallery/41.jpg', alt: 'Farmland near Longthwaite Road' },
  { src: '/images/gallery/42.jpg', alt: 'A horse in a nearby field' },
  { src: '/images/gallery/43.jpg', alt: 'A ewe and her lambs' },
  { src: '/images/gallery/44.jpg', alt: 'Donkeys in a neighbouring field' },
  { src: '/images/gallery/45.jpg', alt: 'Cows grazing near Longthwaite, with the fells beyond' },
  { src: '/images/gallery/60.jpg', alt: 'Horse riders on the lane, with the Solway Firth beyond' },
  { src: '/images/gallery/61.jpg', alt: 'Cuddy Lonning on a summer day' },
  { src: '/images/gallery/62.jpg', alt: 'An early morning walk along the lane' },
  { src: '/images/gallery/63.jpg', alt: 'Skiddaw seen from the lane' },
  { src: '/images/gallery/64.jpg', alt: 'Cows resting in a field, with Skiddaw in the distance' },
  { src: '/images/gallery/65.jpg', alt: 'Horses and sheep in the field opposite' },
  { src: '/images/gallery/66.jpg', alt: 'Local goats' },
  { src: '/images/gallery/67.jpg', alt: 'Donkeys grazing in a neighbouring field' },
  { src: '/images/gallery/68.jpg', alt: 'Sheep grazing beneath the fells' },
  { src: '/images/gallery/69.jpg', alt: 'A horse in a winter rug, with a farmhouse beyond' },
  { src: '/images/gallery/70.jpg', alt: 'The lane in spring, lined with daffodils' },
  { src: '/images/gallery/71.jpg', alt: 'The lane at dusk' },
  { src: '/images/gallery/72.jpg', alt: 'The lane in early spring, with daffodils' },
  { src: '/images/gallery/73.jpg', alt: 'A field gateway on a sunny day' },
  { src: '/images/gallery/74.jpg', alt: 'An old stone barn nearby' },
  { src: '/images/gallery/75.jpg', alt: 'Looking across the countryside to the fells' },
  { src: '/images/gallery/76.jpg', alt: 'A fiery sunset over the fields' },
];
---

<BaseLayout
  title="Local Area — Photos"
  description="Cuddy Lonning and Longthwaite Road — the fields and farm animals around Longthwaite Writers' Retreat."
  section="retreat"
>
  <RetreatSubNav current="photos" />

  <section class="max-w-4xl mx-auto px-6 pt-16 pb-8 text-center">
    <span class="font-sans text-xs font-medium tracking-widest uppercase text-forest">Photos</span>
    <h1 class="font-serif text-5xl font-semibold text-ink mt-3 mb-4">Local Area</h1>
    <p class="font-sans text-ink-light text-lg leading-relaxed max-w-2xl mx-auto">
      Cuddy Lonning and Longthwaite Road &mdash; the fields, fells and farm animals right on the doorstep.
    </p>
  </section>

  <section class="max-w-5xl mx-auto px-6 pb-24">
    <Gallery images={images} />
  </section>

</BaseLayout>
