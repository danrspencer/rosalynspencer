---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RetreatSubNav from '../../components/RetreatSubNav.astro';

const inputClass = 'w-full font-sans text-sm bg-white border border-warm-200 rounded-lg px-4 py-2.5 text-ink placeholder-warm-200 focus:outline-none focus:border-forest transition-colors';
const labelClass = 'block font-sans text-sm text-ink-light mb-1.5';

const agreements = [
  {
    name: 'agree-intro-rate',
    text: 'Yes, please enrol me at the special introductory rate of £15 per month, with the first payment becoming due 1st January 2027.',
  },
  {
    name: 'agree-monthly-payment',
    text: 'I understand membership payments are made monthly on the 1st day of every month.',
  },
  {
    name: 'agree-minimum-term',
    text: 'I understand the introductory membership is offered on the expectation that I will remain a member for at least 12 months.',
  },
];
---

<BaseLayout
  title="Membership Application Form — Longthwaite Writers' Club"
  description="Apply to join the Longthwaite Writers' Club."
  section="retreat"
>
  <RetreatSubNav current="club" />

  <div class="max-w-2xl mx-auto px-6 pt-16 pb-24">
    <span class="font-sans text-xs font-medium tracking-widest uppercase text-forest">Membership Application</span>
    <h1 class="font-serif text-4xl md:text-5xl font-semibold text-ink mt-2 mb-4">Join the Longthwaite Writers&rsquo; Club</h1>
    <p class="font-sans text-warm-400 text-lg mb-10">
      Fill in the form below to apply for membership. Prefer pen and paper? You can
      <a href="/documents/longthwaite-writers-club-membership-form.docx" class="text-forest underline decoration-forest/40 hover:text-forest-dark transition-colors">download the form</a>,
      sign it, and email a photo or scan to <a href="mailto:longthwaiteretreat@gmail.com" class="text-forest underline decoration-forest/40 hover:text-forest-dark transition-colors">longthwaiteretreat@gmail.com</a>, or bring it with you on your next visit.
    </p>

    <form name="membership-application" method="POST" netlify class="space-y-8">
      <input type="hidden" name="form-name" value="membership-application" />

      <fieldset class="space-y-5">
        <legend class="font-serif text-xl text-ink mb-1">Your details</legend>

        <div>
          <label for="name" class={labelClass}>Name</label>
          <input type="text" id="name" name="name" required class={inputClass} placeholder="Your name" />
        </div>

        <div>
          <label for="address" class={labelClass}>Address</label>
          <textarea id="address" name="address" rows="2" required class={inputClass}></textarea>
        </div>

        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label for="postcode" class={labelClass}>Postcode</label>
            <input type="text" id="postcode" name="postcode" required class={inputClass} />
          </div>
          <div>
            <label for="phone" class={labelClass}>Telephone</label>
            <input type="tel" id="phone" name="phone" required class={inputClass} />
          </div>
        </div>

        <div>
          <label for="email" class={labelClass}>Email</label>
          <input type="email" id="email" name="email" required class={inputClass} placeholder="your@email.com" />
        </div>
      </fieldset>

      <fieldset class="space-y-3">
        <legend class="font-serif text-xl text-ink mb-1">I&rsquo;d like to join Longthwaite Writers&rsquo; Club</legend>
        {agreements.map(({ name, text }) => (
          <label class="flex items-start gap-2.5 font-sans text-sm text-ink-light">
            <input type="checkbox" name={name} value="Yes" required class="accent-forest mt-0.5 shrink-0" />
            <span>{text}</span>
          </label>
        ))}
      </fieldset>

      <fieldset class="space-y-5">
        <legend class="font-serif text-xl text-ink mb-1">Signature</legend>
        <p class="font-sans text-sm text-warm-400">Please type your full name to act as your signature.</p>

        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label for="signature" class={labelClass}>Signature</label>
            <input type="text" id="signature" name="signature" required class={inputClass} placeholder="Your full name" />
          </div>
          <div>
            <label for="date" class={labelClass}>Date</label>
            <input type="date" id="date" name="date" required class={inputClass} />
          </div>
        </div>
      </fieldset>

      <button
        type="submit"
        class="w-full bg-forest text-white font-sans text-sm font-medium tracking-wide py-3 rounded-full hover:bg-forest-light transition-colors"
      >
        Submit Application
      </button>
    </form>

    <p class="font-sans text-sm text-warm-400 leading-relaxed mt-8 pt-8 border-t border-warm-200">
      You will be sent payment details and other information shortly. Thank you so much &mdash; we both hope you
      will enjoy your membership and that your writing will flourish.
      <br /><br />
      Sincerely, Rosalyn &amp; Ian
    </p>
  </div>

</BaseLayout>
