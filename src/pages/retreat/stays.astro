---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RetreatSubNav from '../../components/RetreatSubNav.astro';
import Gallery from '../../components/Gallery.astro';
import { RETREAT_URL } from '../../config';

const bedroomImages = [
  { src: '/images/gallery/16.jpg', alt: 'Guest bedroom overlooking the front garden' },
  { src: '/images/gallery/17.jpg', alt: 'Guest bedroom' },
  { src: '/images/gallery/18.jpg', alt: 'Guest bedroom with wardrobe and dressing table' },
  { src: '/images/gallery/19.jpg', alt: 'Bathroom with freestanding bath' },
];

const weekendDates2027 = [
  'Fri 2nd – Mon 5th April',
  'Fri 14th – Mon 17th May',
  'Fri 15th – Mon 18th October',
  'Fri 26th – Mon 29th November',
];

const midweekDates2027 = [
  'Mon 28th June – Thurs 1st July',
  'Mon 26th – Thurs 29th July',
  'Mon 9th – Thurs 12th August',
  'Mon 27th – Thurs 30th September',
];
---

<BaseLayout
  title="Unstructured Retreats & Residential Stays"
  description="Residential stays for individual writers at Longthwaite Writers' Retreat in Cumbria — unstructured time to work on your own writing project."
  section="retreat"
>
  <RetreatSubNav current="stays" />

  <section class="max-w-4xl mx-auto px-6 pt-16 pb-8 text-center">
    <span class="font-sans text-xs font-medium tracking-widest uppercase text-forest">Unstructured</span>
    <h1 class="font-serif text-5xl font-semibold text-ink mt-3 mb-4">Residential Stays for Individual Writers</h1>
    <p class="font-sans text-ink-light text-lg leading-relaxed max-w-2xl mx-auto">
      For those wishing to spend a few days (or longer) here working on a writing project. You will be well looked
      after with healthy plant-based meals and home-made cakes prepared by Ian &mdash; and no household chores to do.
    </p>
  </section>

  <section class="max-w-4xl mx-auto px-6 pb-12">
    <div class="bg-forest-pale rounded-2xl p-6 mb-12 text-center">
      <p class="font-sans text-ink-light mb-1">
        <strong class="text-ink">£450</strong> for one writer (3 nights, full board)
        &mdash; or <strong class="text-ink">£760</strong> for two writers sharing (3 nights, full board).
      </p>
      <p class="font-sans text-sm text-warm-400">
        Longthwaite Writers&rsquo; Club members save 20% &mdash; <a href={`${RETREAT_URL}/contact`} class="text-forest hover:text-forest-dark underline decoration-forest/40 transition-colors">get in touch</a> to find out more.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 gap-10 mb-12">
      <div>
        <h2 class="font-serif text-2xl text-ink mb-3">Bedroom &amp; bathroom</h2>
        <p class="font-sans text-ink-light leading-relaxed">
          Our main guestroom has a king size bed, wardrobe, dressing table and writing bureau next to a window
          with views of fells and farmland. Tea &amp; coffee making facilities in the room, and good Wi-Fi.
          Sole use of the bathroom (including shower &amp; bath).
        </p>
      </div>
      <div>
        <h2 class="font-serif text-2xl text-ink mb-3">Where you can write</h2>
        <p class="font-sans text-ink-light leading-relaxed">
          Choose to write in your own room, the living room (with log burning stove) or the snug (with
          book-lined walls) &ndash; wherever you feel most comfortable. There are lots of outdoor spaces too,
          including the summerhouse by the garden pond and running stream, the covered outdoor snug, a range of
          other tables and chairs around the garden, or simply a blanket on the lawn.
        </p>
      </div>
    </div>

    <div class="grid sm:grid-cols-2 gap-10 mb-12">
      <div>
        <h2 class="font-serif text-2xl text-ink mb-3">Meals</h2>
        <p class="font-sans text-ink-light leading-relaxed">
          Continental breakfast (freshly made filtered coffee, fresh fruit, yoghurt, porridge, toast etc), a
          light lunch, and a two-course evening meal &mdash; all plant based &mdash; included in the price, plus
          home-made cakes. Mealtimes and snack times arranged to suit. Eat with Rosalyn and Ian, or, especially
          if deep in thought, have a meal brought to you on a tray to eat alone in your chosen space.
        </p>
      </div>
      <div>
        <h2 class="font-serif text-2xl text-ink mb-3">Surrounding area</h2>
        <p class="font-sans text-ink-light leading-relaxed">
          Country walks on the doorstep (walking shoes recommended). If you&rsquo;d like to venture further
          afield and don&rsquo;t have your own transport, Rosalyn or Ian will drop you off in town at either the
          train station or bus stop. There are regular bus services to Carlisle, Keswick, Cockermouth and other
          lovely places, as well as train services to Carlisle and a lovely coastal route to Whitehaven.
        </p>
      </div>
    </div>

    <div class="bg-forest-pale rounded-2xl p-6 mb-12">
      <h2 class="font-serif text-xl text-ink mb-2">Wanting to bring a friend?</h2>
      <p class="font-sans text-ink-light leading-relaxed">
        We have a second guest room available with views of our garden, summerhouse and pond. If you come on
        your own you&rsquo;ll have sole use of the bathroom; coming with a friend would mean sharing it.
      </p>
    </div>

    <Gallery images={bedroomImages} />
  </section>

  <section class="max-w-4xl mx-auto px-6 pb-12">
    <h2 class="font-serif text-2xl text-ink mb-5 text-center">2027 Dates</h2>

    <div class="mb-8">
      <h3 class="font-sans text-sm font-medium tracking-wide text-forest mb-2 text-center">
        <span class="uppercase">Weekend Retreats</span> &mdash; 3 nights, Friday 11am&ndash;Monday 10am
      </h3>
      <div class="bg-white/60 rounded-2xl border border-warm-200 px-6 py-2">
        {weekendDates2027.map((dates) => (
          <a
            href={`${RETREAT_URL}/contact?message=${encodeURIComponent(`Hi, I'm interested in an individual residential weekend stay, ${dates} 2027.`)}`}
            class="flex items-center justify-between gap-2 py-3 border-b border-warm-200 last:border-0 group hover:bg-forest-pale/40 -mx-6 px-6 transition-colors first:rounded-t-xl last:rounded-b-xl"
          >
            <span class="font-serif text-lg text-ink group-hover:text-forest transition-colors">{dates}</span>
            <span class="font-sans text-xs text-forest opacity-0 group-hover:opacity-100 transition-opacity">Enquire&nbsp;&rarr;</span>
          </a>
        ))}
      </div>
    </div>

    <div class="mb-8">
      <h3 class="font-sans text-sm font-medium tracking-wide text-forest mb-2 text-center">
        <span class="uppercase">Mid-week Retreats</span> &mdash; 3 nights, Monday 11am&ndash;Thursday 10am
      </h3>
      <div class="bg-white/60 rounded-2xl border border-warm-200 px-6 py-2">
        {midweekDates2027.map((dates) => (
          <a
            href={`${RETREAT_URL}/contact?message=${encodeURIComponent(`Hi, I'm interested in an individual residential mid-week stay, ${dates} 2027.`)}`}
            class="flex items-center justify-between gap-2 py-3 border-b border-warm-200 last:border-0 group hover:bg-forest-pale/40 -mx-6 px-6 transition-colors first:rounded-t-xl last:rounded-b-xl"
          >
            <span class="font-serif text-lg text-ink group-hover:text-forest transition-colors">{dates}</span>
            <span class="font-sans text-xs text-forest opacity-0 group-hover:opacity-100 transition-opacity">Enquire&nbsp;&rarr;</span>
          </a>
        ))}
      </div>
    </div>

    <p class="font-sans text-sm text-warm-400 text-center">
      Want alternative dates, or a longer stay? <a href={`${RETREAT_URL}/contact`} class="text-forest hover:text-forest-dark underline decoration-forest/40 transition-colors">Get in touch</a> to discuss options.
    </p>
  </section>

  <section class="max-w-3xl mx-auto px-6 pb-24 text-center">
    <a
      href={`${RETREAT_URL}/contact`}
      class="inline-block bg-forest text-white font-sans text-sm font-medium tracking-wide px-8 py-3 rounded-full hover:bg-forest-light transition-colors"
    >
      Enquire About a Stay
    </a>
  </section>

</BaseLayout>
