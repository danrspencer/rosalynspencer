---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RetreatSubNav from '../../../components/RetreatSubNav.astro';
import { RETREAT_URL } from '../../../config';

const enquireMessage = `Hi, I'm interested in attending 'Writing for Children' (27–28 June 2026).

Number of attendees:
Accommodation needed (£40–£50/night):
Any questions or special requirements:`;
const enquireHref = `${RETREAT_URL}/contact?message=${encodeURIComponent(enquireMessage)}`;
---

<BaseLayout
  title="Writing for Children — Structured Weekend Retreat"
  description="Writing for Children at Longthwaite Writers' Retreat, 27–28 June 2026 — full details coming soon."
  section="retreat"
>
  <RetreatSubNav current="structured" />

  <section class="max-w-2xl mx-auto px-6 pt-16 pb-24 text-center">
    <span class="font-sans text-xs font-medium tracking-widest uppercase text-forest">Structured Weekend Retreat</span>
    <h1 class="font-serif text-5xl font-semibold text-ink mt-3 mb-4">Writing for Children</h1>
    <p class="font-serif italic text-xl text-warm-400 mb-8">27th &ndash; 28th June, 2026</p>

    <div class="bg-forest-pale rounded-2xl p-6 mb-8 inline-block">
      <p class="font-serif text-3xl text-ink mb-1">£180</p>
      <p class="font-sans text-sm text-ink-light">2 days &middot; all meals &amp; refreshments included</p>
    </div>

    <div class="bg-amber-pale rounded-2xl p-6 mb-8 text-left">
      <p class="font-sans text-xs font-medium tracking-widest uppercase text-amber mb-3 text-center">Guest Speaker</p>
      <h3 class="font-serif text-lg text-ink mb-1">Mia Sneyd</h3>
      <p class="font-sans text-sm text-ink-light">Children&rsquo;s Literature and Literacies.</p>
    </div>

    <p class="font-sans text-ink-light text-lg leading-relaxed mb-10">
      Full details of this retreat are coming soon. In the meantime, get in touch to register your interest
      or ask any questions &mdash; we&rsquo;d love to hear from you.
    </p>

    <a
      href={enquireHref}
      class="inline-block bg-forest text-white font-sans text-sm font-medium tracking-wide px-8 py-3 rounded-full hover:bg-forest-light transition-colors"
    >
      Enquire About This Retreat
    </a>
  </section>

</BaseLayout>
