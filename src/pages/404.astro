---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found"
  description="This page doesn't exist — but here's how to find your way to Rosalyn Spencer's site or the Writing Retreat."
  section="author"
>

  <div class="max-w-2xl mx-auto px-6 pt-20 pb-24 text-center">
    <p class="font-sans text-sage text-sm uppercase tracking-widest mb-4">404</p>
    <h1 class="font-serif text-4xl sm:text-5xl font-semibold text-ink mb-4">Page Not Found</h1>
    <p class="font-sans text-warm-400 text-lg mb-12">
      That page doesn't exist, or has moved. Here's where you might want to go instead.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="/"
        class="font-sans text-sm font-medium tracking-wide px-6 py-3 rounded-full bg-sage text-white hover:bg-sage-light transition-colors"
      >
        Go to the homepage
      </a>
      <a
        href="/retreat"
        class="font-sans text-sm font-medium tracking-wide px-6 py-3 rounded-full border border-warm-200 text-ink hover:border-sage hover:text-sage transition-colors"
      >
        Visit the Writing Retreat
      </a>
    </div>
  </div>

</BaseLayout>
