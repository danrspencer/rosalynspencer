---
import BaseLayout from '../layouts/BaseLayout.astro';
import RetreatSubNav from '../components/RetreatSubNav.astro';
import Gallery from '../components/Gallery.astro';
import { RETREAT_URL } from '../config';

const galleryImages = [
  { src: '/images/gallery/01.jpg', alt: 'Longthwaite farmhouse from the front garden' },
  { src: '/images/gallery/45.jpg', alt: 'Views across the Cumbrian fells' },
  { src: '/images/gallery/06.jpg', alt: 'Inside the farmhouse' },
  { src: '/images/gallery/02.jpg', alt: 'The farmhouse garden' },
  { src: '/images/gallery/05.jpg', alt: 'A quiet writing corner' },
  { src: '/images/gallery/12.jpg', alt: 'The summerhouse' },
  { src: '/images/gallery/11.jpg', alt: 'Wildlife garden and pond' },
  { src: '/images/gallery/37.jpg', alt: 'Homemade plant-based food' },
  { src: '/images/gallery/15.jpg', alt: 'The surrounding countryside' },
];

const sections = [
  { title: 'Structured Weekend Retreats',   blurb: 'Workshops, guest speakers, and homemade food, over two or three days.', href: `${RETREAT_URL}/structured` },
  { title: 'Unstructured Stays',             blurb: 'Residential stays for individual writers, at your own pace.',          href: `${RETREAT_URL}/stays` },
  { title: 'Writing Days',                   blurb: 'Standalone writing days — details coming soon.',                       href: `${RETREAT_URL}/writing-days` },
  { title: 'Photos',                         blurb: 'Food, writing spaces, and the Cumbrian countryside.',                  href: `${RETREAT_URL}/photos` },
  { title: 'Reviews',                        blurb: 'What writers have said about their time at Longthwaite.',              href: `${RETREAT_URL}/reviews` },
];
---

<BaseLayout
  title="Writers' Retreat"
  description="Longthwaite Writers' Retreat — a peaceful 300-year-old Cumbrian farmhouse near the Lake District, offering residential stays and group retreats for writers."
  section="retreat"
>
  <RetreatSubNav />

  <!-- Hero -->
  <section class="max-w-5xl mx-auto px-6 pt-20 pb-12 text-center">
    <span class="font-sans text-xs font-medium tracking-widest uppercase text-forest">Cumbria, England</span>
    <h1 class="font-serif text-5xl md:text-6xl font-semibold text-ink mt-3 mb-4">
      Longthwaite Writers' Retreat
    </h1>
    <p class="font-serif italic text-xl text-warm-400 max-w-2xl mx-auto">
      The perfect place to make progress with your writing in peaceful surroundings.
    </p>
  </section>

  <!-- Farmhouse photo -->
  <section class="max-w-4xl mx-auto px-6 pb-16">
    <img
      src="/images/longthwaite-farmhouse.jpg"
      alt="Longthwaite farmhouse — Rosalyn Spencer's writers' retreat in Cumbria"
      class="w-full rounded-2xl shadow-xl object-cover max-h-[480px]"
    />
  </section>

  <!-- About -->
  <section class="max-w-3xl mx-auto px-6 pb-16">
    <p class="font-sans text-ink-light leading-relaxed text-lg">
      After renovating our 300-year-old Cumbrian Farmhouse &mdash; situated just outside the Lake District National Park
      in Northern England (not far from the Scottish Border) &mdash; Rosalyn and Ian offer residential stays for individual
      writers, as well as two or three-day weekend retreats for up to six writers.
    </p>
    <p class="font-sans text-warm-400 text-sm mt-4 leading-relaxed">
      All stays include homemade plant-based meals and cakes lovingly prepared by Ian, and you&rsquo;ll find plenty of
      beautiful writing spots both inside and around the farmhouse.
    </p>
  </section>

  <!-- Section cards -->
  <section class="max-w-5xl mx-auto px-6 pb-16">
    <div class="grid sm:grid-cols-2 gap-5">
      {sections.map(({ title, blurb, href }) => (
        <a
          href={href}
          class="group flex flex-col bg-white/60 rounded-2xl border border-warm-200 p-6 hover:border-forest/40 hover:bg-forest-pale/40 transition-colors"
        >
          <h2 class="font-serif text-xl text-ink group-hover:text-forest transition-colors mb-1">{title}</h2>
          <p class="font-sans text-sm text-warm-400 leading-relaxed flex-1">{blurb}</p>
          <span class="font-sans text-xs text-forest opacity-0 group-hover:opacity-100 transition-opacity mt-3">Explore &rarr;</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Photo Gallery -->
  <section class="max-w-5xl mx-auto px-6 pb-16">
    <Gallery images={galleryImages} />
    <p class="font-sans text-sm text-warm-400 text-center mt-6">
      See more in <a href={`${RETREAT_URL}/photos`} class="text-forest hover:text-forest-dark underline decoration-forest/40 transition-colors">Photos</a>,
      or <a href={`${RETREAT_URL}/contact`} class="text-forest hover:text-forest-dark underline decoration-forest/40 transition-colors">get in touch</a> to arrange a visit.
    </p>
  </section>

  <!-- Contact CTA -->
  <section class="max-w-3xl mx-auto px-6 pb-24 text-center">
    <h2 class="font-serif text-3xl text-ink mb-4">Interested?</h2>
    <p class="font-sans text-warm-400 mb-8">
      Get in touch with Rosalyn and Ian to discuss dates, availability, and anything else you&rsquo;d like to know.
    </p>
    <a
      href={`${RETREAT_URL}/contact`}
      class="inline-block bg-forest text-white font-sans text-sm font-medium tracking-wide px-8 py-3 rounded-full hover:bg-forest-light transition-colors"
    >
      Get in Touch
    </a>
  </section>

</BaseLayout>
